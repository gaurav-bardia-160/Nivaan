# GovBank Assistant Environment Configuration
# Copy this file to backend/.env and populate real keys for local development.

ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# AI Provider API Keys (Fill in chosen provider)
AI_PROVIDER=none  # options: none, openai, gemini, anthropic
AI_API_KEY=

# OCR Settings
TESSERACT_CMD=

# Translation / TTS Settings
BHASHINI_API_KEY=
BHASHINI_USER_ID=
