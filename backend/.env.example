# Keep disabled until candidate-corpus retrieval behavior has been evaluated.
RAG_ENABLED=false
# Build with `python -m backend.offline.build_vector_db`, then enable hybrid retrieval.
RAG_VECTOR_ENABLED=false

# Optional privacy-preserving local answer enhancement. The deterministic
# cited answer remains the fallback if Ollama is stopped or returns invalid data.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen3.5:4b
LOCAL_LLM_TIMEOUT_SECONDS=20
LOCAL_LLM_ALLOW_REMOTE=false

# Process-local redacted conversation memory limits.
MEMORY_MAX_CONVERSATIONS=500
MEMORY_MAX_TURNS=6
MEMORY_TTL_SECONDS=1800

# Production deployments should set exact origins and a strong API key.
CORS_ORIGINS=http://127.0.0.1:5500
API_KEY=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=120

# ── Web Search Fallback Pipeline (Phase 1 — Live, Ephemeral, Read-Only to Qdrant) ──
# Set to true to enable web search when RAG confidence < WEB_SEARCH_CONFIDENCE_THRESHOLD.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_CONFIDENCE_THRESHOLD=0.75
# Optional: SerpAPI key for higher quality search results (leave empty to use DDGS).
SERPAPI_KEY=

# ── Background ETL Pipeline (Phase 2 — Offline, Scheduled Write Path) ──
# Interval in hours for the ETL scheduler to run extract -> refine -> vectorize.
ETL_INTERVAL_HOURS=4
